---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
		.filter((p) => !p.id.startsWith('changelog/') && !p.id.startsWith('关于/'))
		.sort(
			(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
		);

function getCategory(id: string): string {
	const parts = id.split('/');
	return parts.length > 1 ? parts[0] : '未分类';
}

const grouped = new Map<string, typeof posts>();
for (const post of posts) {
	const cat = getCategory(post.id);
	if (!grouped.has(cat)) grouped.set(cat, []);
	grouped.get(cat)!.push(post);
}

const categories = [...grouped.entries()].sort(
	(a, b) => b[1][0].data.pubDate.valueOf() - a[1][0].data.pubDate.valueOf(),
);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	{
		categories.map(([category, categoryPosts]) => (
			<section class="category">
				<h2>
					{category}
					<span class="post-count">{categoryPosts.length}</span>
				</h2>
				<ul class="post-grid">
					{categoryPosts.map((post, i) => (
						<li style={`animation-delay: ${i * 0.08}s`}>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</PageLayout>

<style>
	.category {
		margin-bottom: 2.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-card-border);
	}
	.category:first-child {
		border-top: none;
		padding-top: 0;
	}
	.category h2 {
		margin-bottom: 1.5rem;
		font-size: 1.25em;
		font-weight: 700;
		color: var(--color-text-secondary);
		border-bottom: none;
		padding-left: 0;
		border-left: none;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.post-count {
		font-size: 0.65em;
		background: var(--color-accent-subtle);
		color: var(--color-accent);
		padding: 0.15em 0.6em;
		border-radius: 99px;
		font-weight: 600;
	}
	.post-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	.post-grid li {
		width: calc(50% - 1rem);
		background: var(--color-card-bg);
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius-md);
		transition: box-shadow var(--transition-normal), transform var(--transition-normal);
		animation: card-enter 0.5s ease both;
		overflow: hidden;
	}
	.post-grid li:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
		border-left: 3px solid var(--color-accent);
	}
	.post-grid li * { text-decoration: none; transition: 0.2s ease; }
	.post-grid li img { margin-bottom: 0; border-radius: 0; }
	.post-grid li a { display: block; padding: 1.25em; }
	.post-grid li a:has(img) { padding: 0 0 1.25em; }
	.post-grid li a:has(img) .title,
	.post-grid li a:has(img) .date { padding: 0 1.25em; }
	.post-grid li a:has(img) .title { padding-top: 1.25em; }
	.title { margin: 0; color: rgb(var(--black)); line-height: 1.2; font-size: 1.25em; }
	.date { margin: 0.5em 0 0; color: var(--color-text-tertiary); font-size: 0.9em; }
	.post-grid li a:hover h4 { color: var(--color-accent); }

	@keyframes card-enter {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 720px) {
		.category {
			margin-bottom: 1.75rem;
			padding-top: 1.25rem;
		}
		.category h2 {
			font-size: 0.95em;
			margin-bottom: 0.85rem;
			flex-wrap: wrap;
			gap: 0.35em;
			padding-left: 0.6em;
			border-left: 3px solid var(--color-accent);
		}
		.post-grid {
			gap: 0.6rem;
		}
		.post-grid li {
			width: 100%;
			background: transparent;
			border: none;
			border-bottom: 1px solid var(--color-border-light);
			border-radius: 0;
		}
		.post-grid li:hover {
			box-shadow: none;
			transform: none;
			border-left: none;
		}
		.post-grid li a {
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			gap: 0.75em;
			padding: 0.85em 0.25em;
		}
		.post-grid li img {
			width: 80px;
			height: 50px;
			border-radius: var(--radius-sm);
			object-fit: cover;
			flex-shrink: 0;
			margin-top: 0.15em;
		}
		.post-grid li a:has(img) {
			padding: 0.85em 0.25em;
		}
		.post-grid li a:has(img) .title,
		.post-grid li a:has(img) .date {
			padding: 0;
		}
		.post-grid li a:has(img) .title {
			padding-top: 0;
		}
		.post-grid li a:after {
			content: "→";
			flex-shrink: 0;
			margin-left: auto;
			color: var(--color-text-tertiary);
			font-size: 0.85em;
			align-self: center;
		}
		.title {
			font-size: 1em;
			line-height: 1.35;
			flex: 1;
			min-width: 0;
		}
		.date {
			font-size: 0.72em;
			margin: 0.25em 0 0;
		}
	}
</style>
