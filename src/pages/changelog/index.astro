---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const rawEntries = (await getCollection('blog'))
  .filter((entry) => entry.id.startsWith('changelog/'))
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

const entries = await Promise.all(
  rawEntries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);
---

<PageLayout title="更新日志" description="费曼花园的每一次改动记录">
  <main>
    {
      entries.map((entry) => (
        <article class="changelog-entry">
          <header>
            <FormattedDate date={entry.data.pubDate} />
            <div class="tags">
              {entry.data.categories.map((cat: string) => (
                <span class="tag">{cat}</span>
              ))}
            </div>
          </header>
          <div class="content">
            <entry.Content />
          </div>
        </article>
      ))
    }
  </main>
</PageLayout>

<style>
  main { width: min(var(--content-wide), 100% - 2em); margin: 0 auto; padding: 2rem 1em; }
  .changelog-entry {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .changelog-entry header {
    display: flex;
    align-items: center;
    gap: 0.75em;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-card-border);
    box-shadow: none;
    background: none;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4em; }
  .tag {
    font-size: 0.8em;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    padding: 0.15em 0.5em;
    border-radius: 99px;
    white-space: nowrap;
  }
  .content :global(h1) { font-size: 1.4em; margin-top: 0; }
  .content :global(h2) { font-size: 1.1em; }
  .content :global(h3) { font-size: 1em; }

  @media (max-width: 720px) {
    main { width: 100%; padding: 1rem 0.5em; }
    .changelog-entry {
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: var(--radius-sm);
    }
    .changelog-entry header {
      flex-wrap: wrap;
      gap: 0.4em;
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
    }
    .tags { gap: 0.25em; }
    .tag { font-size: 0.68em; padding: 0.1em 0.35em; }
    .content :global(h1) { font-size: 1.1em; margin-bottom: 0.4rem; }
    .content :global(h2) { font-size: 1em; margin-bottom: 0.3rem; }
    .content :global(h3) { font-size: 0.9em; }
    .content :global(p) { font-size: 0.9em; margin-bottom: 0.6em; }
    .content :global(ul), .content :global(ol) { padding-left: 1.25em; }
    .content :global(li) { font-size: 0.9em; margin-bottom: 0.3em; }
  }
</style>
