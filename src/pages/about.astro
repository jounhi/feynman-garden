---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_TITLE } from '../consts';

const posts = await getCollection('blog');
const about = posts.find((p) => p.id === '关于/关于我');
const { Content } = about ? await render(about) : { Content: null };
---

<PageLayout title={`关于 - ${SITE_TITLE}`} description="关于 jounhi 和这个博客">
  <article class="prose">
    {Content ? <Content /> : <p>关于页面内容未找到。</p>}
  </article>
</PageLayout>

<style>
  .prose { max-width: 720px; margin: 0 auto; padding: 2em 0; }
  .prose :global(h1) { font-size: 2.441em; margin: 0 0 0.75em; }
  .prose :global(h2) { font-size: 1.563em; margin: 1.5em 0 0.5em; }
  .prose :global(h3) { font-size: 1.25em; margin: 1.25em 0 0.4em; }
  .prose :global(p) { line-height: 1.7; margin-bottom: 1.25em; color: var(--color-text-secondary); }
  .prose :global(ul) { line-height: 1.7; color: var(--color-text-secondary); padding-left: 1.5em; }
  .prose :global(li) { margin-bottom: 0.5em; }
</style>
