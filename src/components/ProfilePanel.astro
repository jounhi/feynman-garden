---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const profiles = await getCollection('profile');
const profile = profiles[0];

const { name, bio, email, github, skills, interests } = profile?.data ?? {};
---

<div id="panel-backdrop" class="panel-backdrop"></div>
<aside id="profile-panel" class="panel" role="dialog" aria-label="个人信息">
	<div class="panel-header">
		<h2>{name}</h2>
		<button id="panel-close" class="panel-close" aria-label="关闭" type="button">
			<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
			</svg>
		</button>
	</div>

	<div class="panel-body">
		<div class="avatar-large">
			{profile?.data.avatar ? (
				<Image src={profile.data.avatar} alt="" width={80} height={80} />
			) : (
				<svg viewBox="0 0 24 24" aria-hidden="true" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
				</svg>
			)}
		</div>

		<p class="bio">{bio}</p>

		<div class="contact-links">
			{email && (
				<a href={`mailto:${email}`} class="contact-link">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/>
					</svg>
					{email}
				</a>
			)}
			{github && (
				<a href={github} target="_blank" class="contact-link">
					<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
					</svg>
					GitHub
				</a>
			)}
		</div>

		{skills && skills.length > 0 && (
			<div class="tag-group">
				<h3>技能</h3>
				<div class="tags">
					{skills.map((skill) => <span class="tag">{skill}</span>)}
				</div>
			</div>
		)}

		{interests && interests.length > 0 && (
			<div class="tag-group">
				<h3>兴趣</h3>
				<div class="tags">
					{interests.map((interest) => <span class="tag">{interest}</span>)}
				</div>
			</div>
		)}
	</div>
</aside>

<style>
	.panel-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.3);
		z-index: 90;
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--transition-normal);
	}
	.panel {
		position: fixed;
		top: 0;
		right: 0;
		width: 380px;
		max-width: 85vw;
		height: 100vh;
		height: 100dvh;
		background: var(--color-bg);
		z-index: 100;
		transform: translateX(105%);
		transition: transform var(--transition-slow) cubic-bezier(0.4, 0, 0.2, 1);
		overflow-y: auto;
		box-shadow: -4px 0 24px var(--color-card-shadow);
		color: var(--color-text);
	}

	body[data-panel-open] .panel-backdrop {
		opacity: 1;
		pointer-events: auto;
	}
	body[data-panel-open] .panel {
		transform: translateX(0);
	}

	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5em 1.5em 0;
	}
	.panel-header h2 {
		font-size: 1.25em;
		margin: 0;
		color: rgb(var(--black));
	}
	.panel-close {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25em;
		color: var(--color-text-tertiary);
		border-radius: var(--radius-sm);
		transition: color var(--transition-fast), background var(--transition-fast);
		display: flex;
	}
	.panel-close:hover {
		color: var(--color-text);
		background: var(--color-bg-secondary);
	}

	.panel-body { padding: 1.5em; }
	.avatar-large {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: var(--color-bg-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-tertiary);
		margin-bottom: 1em;
		overflow: hidden;
	}
	.avatar-large img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}
	.bio {
		font-size: 0.95em;
		color: var(--color-text-secondary);
		margin: 0 0 1.5em;
		line-height: 1.6;
	}

	.contact-links {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		margin-bottom: 1.5em;
	}
	.contact-link {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.9em;
		color: var(--color-text-secondary);
		text-decoration: none;
		padding: 0.5em;
		border-radius: var(--radius-sm);
		transition: background var(--transition-fast), color var(--transition-fast);
	}
	.contact-link:hover {
		background: var(--color-bg-secondary);
		color: var(--color-accent);
	}

	.tag-group { margin-bottom: 1.25em; }
	.tag-group h3 {
		font-size: 0.85em;
		color: var(--color-text-tertiary);
		margin: 0 0 0.5em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.tags { display: flex; flex-wrap: wrap; gap: 0.4em; }
	.tag {
		font-size: 0.8em;
		padding: 0.25em 0.75em;
		background: var(--color-accent-subtle);
		color: var(--color-accent);
		border-radius: 99px;
		font-weight: 500;
	}

	@media (max-width: 480px) {
		.panel { width: 100vw; max-width: 100vw; }
	}
</style>
