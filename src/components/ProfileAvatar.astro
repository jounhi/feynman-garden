---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const profiles = await getCollection('profile');
const profile = profiles[0];
---

<button id="avatar-btn" class="avatar-btn" aria-label="关于我" type="button">
	{profile?.data.avatar ? (
		<Image src={profile.data.avatar} alt="" width={36} height={36} />
	) : (
		<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
		</svg>
	)}
</button>

<style>
	.avatar-btn {
		background: none;
		border: 2px solid var(--color-border);
		border-radius: 50%;
		cursor: pointer;
		padding: 4px;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		transition: border-color var(--transition-fast), background var(--transition-fast);
		overflow: hidden;
	}
	.avatar-btn:hover {
		border-color: var(--color-accent);
		background: var(--color-accent-subtle);
	}
	.avatar-btn img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}
</style>
