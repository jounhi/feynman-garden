---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProfilePanel from '../components/ProfilePanel.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	lang?: string;
}

const { title, description, image, lang = 'zh-CN' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<ProfilePanel />
		<script is:inline>
			(function(){
				var btn = document.getElementById('theme-toggle');
				if (btn) {
					btn.addEventListener('click', function(){
						var el = document.documentElement;
						var curr = el.getAttribute('data-theme');
						var next = curr === 'dark' ? 'light' : 'dark';
						el.setAttribute('data-theme', next);
						localStorage.setItem('theme', next);
					});
				}
				var avatarBtn = document.getElementById('avatar-btn');
				var panelClose = document.getElementById('panel-close');
				var backdrop = document.getElementById('panel-backdrop');
				function openPanel() { document.body.setAttribute('data-panel-open', ''); }
				function closePanel() { document.body.removeAttribute('data-panel-open'); }
				if (avatarBtn) avatarBtn.addEventListener('click', openPanel);
				if (panelClose) panelClose.addEventListener('click', closePanel);
				if (backdrop) backdrop.addEventListener('click', closePanel);
				document.addEventListener('keydown', function(e){
					if (e.key === 'Escape') closePanel();
				});
			})();
		</script>
	</body>
</html>
